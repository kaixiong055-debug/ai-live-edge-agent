<Window x:Class="AiLiveEdge.Desktop.CloseAgentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭 AI Live Edge"
        Width="500" Height="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0D1019">
  <Border Margin="18" Padding="28" CornerRadius="20" Background="#141824"
          BorderBrush="#18FFFFFF" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock FontSize="21" FontWeight="SemiBold" Foreground="#F3F4FA"
                 Text="退出 AI Live Edge？" />
      <TextBlock Grid.Row="1" Margin="0,9,0,18" Foreground="#8E96AA" TextWrapping="Wrap"
                 Text="你可以让本地伴播服务继续在后台运行，以保持直播连接。" />

      <StackPanel Grid.Row="2">
        <RadioButton x:Name="ContinueRadio" IsChecked="True" Margin="0,7"
                     Foreground="#E2E4EC" FontSize="14" Content="继续在后台运行（推荐）" />
        <RadioButton x:Name="StopRadio" Margin="0,7" Foreground="#E2E4EC"
                     FontSize="14" Content="退出并停止本地伴播服务" />
      </StackPanel>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button MinWidth="88" Height="36" Margin="4" IsCancel="True" Click="Cancel_Click"
                Background="#252A39" Foreground="#E4E6EF">取消</Button>
        <Button MinWidth="100" Height="36" Margin="4" IsDefault="True" Click="Confirm_Click"
                Background="#7658F4" Foreground="White">确认退出</Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
