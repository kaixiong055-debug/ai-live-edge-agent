<Window x:Class="AiLiveEdge.Desktop.LiveOutput.LiveOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AI Live Renderer"
        Width="405" Height="720"
        MinWidth="240" MinHeight="240"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        AllowsTransparency="False"
        Background="#00FF00"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        Closed="Window_Closed">
  <Grid x:Name="OutputRoot" Background="#00FF00">
    <wv2:WebView2 x:Name="OutputWebView" Margin="0" />
  </Grid>
</Window>
